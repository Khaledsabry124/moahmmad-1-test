<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF16323A">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFE8C468"
        android:text="صلوات اليوم"
        android:paddingBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/row1_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="الفجر"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/row1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8FA9AF"
            android:text="٤:٥٢ ص"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/row1_toggle"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF4E8B6B"
            android:text="✓"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/row2_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="الظهر"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/row2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8FA9AF"
            android:text="١٢:٥٨ م"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/row2_toggle"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF8FA9AF"
            android:text="○"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/row3_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="العصر"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/row3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8FA9AF"
            android:text="٤:٣٥ م"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/row3_toggle"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF8FA9AF"
            android:text="○"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/row4_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="المغرب"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/row4_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8FA9AF"
            android:text="٧:٣١ م"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/row4_toggle"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF8FA9AF"
            android:text="○"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/row5_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="العشاء"
            android:singleLine="true"/>
        <TextView
            android:id="@+id/row5_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FF8FA9AF"
            android:text="٨:٥٣ م"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/row5_toggle"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF8FA9AF"
            android:text="○"/>
    </LinearLayout>
</LinearLayout>
